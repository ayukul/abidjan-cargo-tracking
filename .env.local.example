# Session configuration
# Generate a random string of at least 32 characters
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-secret-key-change-in-production-min-32-chars!!

# Node environment
NODE_ENV=development

# Database location (relative to project root)
# SQLite database will be created automatically if it doesn't exist
DATABASE_URL=./db/cargo.db
